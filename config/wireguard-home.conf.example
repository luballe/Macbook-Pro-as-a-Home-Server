# /etc/wireguard/wg-home.conf on the server (example; keys and IPs are placeholders).
# Forward UDP 51830 on your router to the server's LAN IP.
[Interface]
Address = 10.60.0.1/24
ListenPort = 51830
# Keep the private key in its own root-only file instead of in this file:
PostUp = wg set %i private-key /etc/wireguard/wg-home.key

[Peer]
# Laptop
PublicKey = <laptop-public-key>
AllowedIPs = 10.60.0.2/32
